---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="page">
    <header class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-grid">
        <div class="hero-copy">
          <a
            class="brand"
            href="https://www.cloudways.com/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              src="/cloudways-logo.svg"
              alt="Cloudways"
              width="220"
              height="42"
            />
          </a>

          <h1>Your Astro app is live</h1>

          <p class="lead">
            This is a sample Astro starter from Cloudways. Use it as a template
            to ship your own project on Cloudways or any static host.
          </p>

          <div class="actions">
            <a
              class="btn btn-primary"
              href="https://www.cloudways.com/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit Cloudways
            </a>
            <a
              class="btn btn-secondary"
              href="https://docs.astro.build/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Astro docs
            </a>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <img src="/hero-cloud.svg" alt="" width="960" height="640" />
        </div>
      </div>
    </header>

    <main class="content">
      <section class="section" aria-labelledby="next-steps">
        <h2 id="next-steps">Build from this template</h2>
        <p class="section-lead">
          Replace this sample page with your routes, components, and content.
        </p>

        <ol class="steps">
          <li>
            <span class="step-index">01</span>
            <div>
              <h3>Develop locally</h3>
              <p>Run <code>npm run dev</code> and edit <code>src/pages/</code>.</p>
            </div>
          </li>
          <li>
            <span class="step-index">02</span>
            <div>
              <h3>Build for production</h3>
              <p>Generate static files with <code>npm run build</code>.</p>
            </div>
          </li>
          <li>
            <span class="step-index">03</span>
            <div>
              <h3>Deploy anywhere</h3>
              <p>Upload <code>dist/</code> to Cloudways, Netlify, Vercel, or a VPS.</p>
            </div>
          </li>
        </ol>
      </section>

      <aside class="notice">
        <p>
          <strong>Sample app notice:</strong> This page is provided by Cloudways
          as a demonstration starter. Swap it for your own application to go live.
        </p>
      </aside>
    </main>

    <footer class="footer">
      <p>
        Sample app from
        <a href="https://www.cloudways.com/" target="_blank" rel="noopener noreferrer"
          >Cloudways</a
        >
        · Managed cloud hosting for developers
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(100vh, 820px);
    display: flex;
    align-items: center;
    padding: 3.5rem 1.5rem 4.5rem;
    color: var(--cw-white);
    background:
      linear-gradient(145deg, var(--cw-navy) 0%, var(--cw-navy-mid) 48%, var(--cw-blue) 100%);
  }

  .hero-glow {
    position: absolute;
    inset: -20% -10% auto auto;
    width: min(70vw, 720px);
    height: min(70vw, 720px);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(7, 235, 173, 0.22) 0%,
      rgba(183, 99, 215, 0.12) 42%,
      transparent 70%
    );
    animation: drift 14s var(--ease-out) infinite alternate;
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    width: min(1120px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  .brand {
    display: inline-flex;
    padding: 0.75rem 1.1rem;
    margin-bottom: 1.75rem;
    background: var(--cw-white);
    border-radius: 14px;
    text-decoration: none;
    animation: rise 0.8s var(--ease-out) both;
  }

  .brand img {
    width: min(220px, 62vw);
    height: auto;
  }

  .hero-copy h1 {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    max-width: 11ch;
    animation: rise 0.9s var(--ease-out) 0.08s both;
  }

  .lead {
    margin: 0 0 2rem;
    max-width: 38rem;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: rgba(255, 255, 255, 0.84);
    animation: rise 0.9s var(--ease-out) 0.16s both;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    animation: rise 0.9s var(--ease-out) 0.24s both;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.4rem;
    border-radius: 12px;
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.2s var(--ease-out),
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background: var(--cw-teal);
    color: var(--cw-navy);
    box-shadow: 0 10px 28px rgba(7, 235, 173, 0.28);
  }

  .btn-primary:hover {
    background: #09ffc0;
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: var(--cw-white);
    border: 1px solid rgba(255, 255, 255, 0.22);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.14);
  }

  .hero-visual {
    animation: float-in 1.1s var(--ease-out) 0.18s both;
  }

  .hero-visual img {
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
    filter: drop-shadow(0 24px 48px rgba(7, 9, 40, 0.35));
    animation: float 8s ease-in-out infinite;
  }

  .content {
    flex: 1;
    width: min(960px, 100%);
    margin: 0 auto;
    padding: 3.5rem 1.5rem 3rem;
  }

  .section h2 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2rem);
    letter-spacing: -0.03em;
  }

  .section-lead {
    margin: 0 0 2rem;
    color: var(--cw-slate);
    max-width: 42ch;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    padding-block: 0.35rem;
  }

  .step-index {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    color: var(--cw-blue);
    padding-top: 0.2rem;
  }

  .steps h3 {
    margin: 0 0 0.25rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .steps p {
    margin: 0;
    color: var(--cw-slate);
  }

  .steps code {
    font-size: 0.9em;
    padding: 0.12rem 0.4rem;
    border-radius: 6px;
    background: rgba(44, 57, 189, 0.08);
    color: var(--cw-blue);
  }

  .notice {
    margin-top: 2.5rem;
    padding: 1.25rem 1.4rem;
    border-left: 4px solid var(--cw-teal);
    background: linear-gradient(
      90deg,
      rgba(44, 57, 189, 0.06),
      rgba(7, 235, 173, 0.08)
    );
  }

  .notice p {
    margin: 0;
    color: var(--cw-slate);
  }

  .notice strong {
    color: var(--cw-navy);
  }

  .footer {
    margin-top: auto;
    padding: 1.5rem;
    text-align: center;
    color: var(--cw-slate);
    font-size: 0.9rem;
    border-top: 1px solid rgba(44, 57, 189, 0.1);
    background: var(--cw-white);
  }

  .footer a {
    color: var(--cw-blue);
    font-weight: 600;
    text-decoration: none;
  }

  .footer a:hover {
    text-decoration: underline;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateX(24px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(-6%, 8%, 0) scale(1.08);
    }
  }

  @media (max-width: 860px) {
    .hero {
      min-height: auto;
      padding-top: 2.5rem;
      padding-bottom: 3rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      order: -1;
      max-width: 420px;
      margin-inline: auto;
    }

    .hero-copy h1 {
      max-width: none;
    }
  }
</style>
